{
  "name": "@siren-ui/playground",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web --output-dir dist",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "export": "expo export --platform web --output-dir dist",
    "generate:audio": "node scripts/generate-demo-audio.mjs && prettier --write data/demo-audio.generated.ts",
    "lint": "expo lint",
    "start": "expo start --dev-client",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@siren-ui/core": "workspace:*",
    "expo": "57.0.11",
    "expo-asset": "57.0.9",
    "expo-audio": "57.0.3",
    "expo-constants": "57.0.9",
    "expo-dev-client": "57.0.10",
    "expo-haptics": "57.0.1",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.11",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.0",
    "expo-doctor": "^1.20.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "57.0.1",
    "jest-expo": "57.0.3",
    "typescript": "~6.0.3"
  }
}
